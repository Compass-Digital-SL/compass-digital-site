# Long-cache the theme's static assets. Vite fingerprints JS/CSS filenames
# (content hash), and the fonts/OG images are stable, so they can be cached
# immutably for a year. Applies to this folder and its subfolders (dist/, fonts/,
# og/). Apache only — cPanel hosting reads this. Nginx hosts set the
# equivalent in the server block (see docs/GO-LIVE.md).

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2|avif|webp|png|jpg|jpeg|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType image/avif               "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
</IfModule>

# Compress text assets when the server negotiates it (woff2/avif/webp are
# already compressed and are left alone).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml application/json
</IfModule>
