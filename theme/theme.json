{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "near-black", "color": "#0A0C10", "name": "Near-black" },
				{ "slug": "ivory", "color": "#F6F2EA", "name": "Ivory" },
				{ "slug": "ink", "color": "#12151B", "name": "Ink" },
				{ "slug": "teal", "color": "#1C8282", "name": "Teal" },
				{ "slug": "muted", "color": "#8E96A3", "name": "Muted" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "\"Inter\", \"Inter Fallback\", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif Display",
					"fontFamily": "\"Fraunces\", \"Fraunces Fallback\", Georgia, Cambria, \"Times New Roman\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "clamp(0.875rem, 0.85rem + 0.1vw, 0.9375rem)", "name": "Small" },
				{ "slug": "medium", "size": "clamp(1rem, 0.97rem + 0.15vw, 1.0625rem)", "name": "Medium" },
				{ "slug": "large", "size": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)", "name": "Large" },
				{ "slug": "x-large", "size": "clamp(1.75rem, 1.5rem + 1.25vw, 2.5rem)", "name": "Extra large" },
				{ "slug": "xx-large", "size": "clamp(2.25rem, 1.8rem + 2.25vw, 3.75rem)", "name": "Display" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "size": "clamp(0.75rem, 0.7rem + 0.25vw, 1rem)", "name": "Small" },
				{ "slug": "40", "size": "clamp(1.25rem, 1rem + 1.25vw, 2rem)", "name": "Medium" },
				{ "slug": "60", "size": "clamp(2rem, 1.5rem + 2.5vw, 4rem)", "name": "Large" },
				{ "slug": "80", "size": "clamp(3rem, 2rem + 5vw, 6rem)", "name": "Extra large" }
			]
		}
	},
	"styles": {
		"color": { "background": "#0F2A43", "text": "#F6F2EA" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "lineHeight": "1.6" }
	}
}
