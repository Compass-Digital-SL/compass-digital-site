{
	"core": "WordPress/WordPress#7.1.4",
	"phpVersion": "8.3",
	"themes": [
		"./theme"
	],
	"plugins": [
		"seo-by-rank-math"
	],
	"mappings": {
		"wp-content/plugins/compass-digital": "./plugins"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"env": {
		"development": {
			"plugins": [
				"query-monitor"
			]
		}
	}
}
